# --- PostgreSQL ---
POSTGRES_NAME=my_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=changeme
POSTGRES_USER=postgres

# --- Telegram bot ---
# Токен бота от @BotFather
BOT_TOKEN=123456:PUT-YOUR-TOKEN-HERE
# Список Telegram id администраторов (JSON-массив)
BOT_ADMINS=[123456789]

# --- Webhook ---
# Публичный HTTPS-адрес бота БЕЗ пути, например https://bot.example.com.
# Если оставить пустым — бот запустится в режиме long polling (для локальной разработки).
WEBHOOK_BASE_URL=
# Путь, на который Telegram присылает обновления
WEBHOOK_PATH=/webhook
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (желательно задать)
WEBHOOK_SECRET=
# Локальный адрес и порт HTTP-сервера внутри контейнера
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Удалить накопившиеся обновления при установке webhook (true/false)
WEBHOOK_DROP_PENDING=false

# --- Reverse proxy (Caddy, профиль proxy) ---
# Домен для автоматического HTTPS, например bot.example.com
WEBHOOK_DOMAIN=
